{
	"info": {
		"_postman_id": "bth3-product-service-soa",
		"name": "BTH3 - Product Management Service (SOA Architecture)",
		"description": "Bộ sưu tập kiểm thử API cho Bài Thực Hành Số 3: Dịch vụ Quản lý sản phẩm (SOA) xác thực qua Auth Service BTH2.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth Service (Port 8080)",
			"item": [
				{
					"name": "1.1 Đăng nhập lấy Token JWT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"    console.log(\"Saved token:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"admin\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Xác thực Token tại Auth Service",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/auth",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"auth"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Product Service (Port 8081)",
			"item": [
				{
					"name": "2.1 GET All Products - Lấy danh sách sản phẩm",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8081/products",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.2 GET Product by ID - Chi tiết sản phẩm",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8081/products/1",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products",
								"1"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.3 POST Product - Thêm sản phẩm mới",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Bàn phím cơ Keychron K2 Pro\",\n    \"description\": \"Bàn phím cơ không dây Bluetooth, Gateron Brown Switch\",\n    \"price\": 2150000.00,\n    \"quantity\": 30\n}"
						},
						"url": {
							"raw": "http://localhost:8081/products",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.4 PUT Product - Cập nhật sản phẩm",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Bàn phím cơ Keychron K2 Pro (Version 2)\",\n    \"description\": \"Nâng cấp Hot-swap RGB, foam tiêu âm\",\n    \"price\": 2350000.00,\n    \"quantity\": 20\n}"
						},
						"url": {
							"raw": "http://localhost:8081/products/1",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products",
								"1"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.5 DELETE Product - Xóa sản phẩm",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8081/products/1",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products",
								"1"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Kiểm thử Bảo mật (Authentication Validation)",
			"item": [
				{
					"name": "3.1 GET /products không có Token (Kỳ vọng: 401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/products",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "3.2 GET /products với Token giả mạo/hết hạn (Kỳ vọng: 401)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer fake_or_expired_jwt_token_12345"
							}
						],
						"url": {
							"raw": "http://localhost:8081/products",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"products"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "jwt_token",
			"value": ""
		}
	]
}
