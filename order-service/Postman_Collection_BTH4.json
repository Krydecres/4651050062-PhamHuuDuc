								"{{auth_url}}"
							],
							"path": []
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"admin\",\n    \"password\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"HTTP status = 200\", function () { pm.response.to.have.status(200); });",
									"var d = pm.response.json();",
									"pm.collectionVariables.set(\"jwt_token\", d.token);",
									"pm.test(\"Nhận được token JWT\", function () { pm.expect(d.token).to.be.a(\"string\").and.not.empty; });"
								]
