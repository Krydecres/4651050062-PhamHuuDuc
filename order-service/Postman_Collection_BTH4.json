				{
					"name": "2.1 POST /orders - Tạo đơn hàng (kiểm tra tồn kho)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{order_url}}/orders",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"orders"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customer_name\": \"Nguyễn Văn A\",\n    \"customer_email\": \"nguyenvana@gmail.com\",\n    \"items\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 1\n        },\n        {\n            \"product_id\": 3,\n            \"quantity\": 2\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"HTTP status = 201\", function () { pm.response.to.have.status(201); });",
									"pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
									"var o = pm.response.json().data;",
									"pm.collectionVariables.set(\"order_id\", o.id);",
									"pm.test(\"Trạng thái mặc định = pending\", function () { pm.expect(o.status).to.eql(\"pending\"); });",
									"pm.test(\"Có 2 mặt hàng, lấy tên & giá từ Product Service\", function () {",
									"    pm.expect(o.items.length).to.eql(2);",
									"    o.items.forEach(function (i) { pm.expect(i.product_name).to.not.be.empty; pm.expect(i.unit_price).to.be.above(0); });",
									"});",
									"pm.test(\"total_price = quantity * unit_price\", function () {",
									"    o.items.forEach(function (i) { pm.expect(Number(i.total_price)).to.be.closeTo(i.quantity * i.unit_price, 0.001); });",
									"});",
									"pm.test(\"total_amount = tổng total_price\", function () {",
									"    var s = o.items.reduce(function (a, i) { return a + Number(i.total_price); }, 0);",
									"    pm.expect(Number(o.total_amount)).to.be.closeTo(s, 0.001);",
									"});"
								]
							}
						}
					]
				},
