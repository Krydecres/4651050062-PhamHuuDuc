		{
			"name": "3. Báo cáo theo sản phẩm (/reports/products)",
			"item": [
				{
					"name": "3.1 POST /reports/products - Báo cáo Chuột (có giá nhập)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{report_url}}/reports/products",
							"host": [
								"{{report_url}}"
							],
							"path": [
								"reports",
								"products"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"product_id\": 3,\n    \"unit_cost\": 2000000\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"HTTP status = 201\", function () { pm.response.to.have.status(201); });",
									"pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
									"var r = pm.response.json().data;",
									"pm.collectionVariables.set(\"product_report_id\", r.id);",
									"pm.test(\"Báo cáo tổng hợp (order_report_id = null)\", function () { pm.expect(r.order_report_id).to.be.null; });",
									"pm.test(\"Đã bán >= 2 (đơn mẫu), đơn pending không tính\", function () { pm.expect(r.total_sold).to.be.at.least(2); });",
									"pm.test(\"Có số lượng tồn kho từ Product Service\", function () { pm.expect(r.stock_quantity).to.be.a(\"number\"); });",
									"pm.test(\"cost = total_sold x 2000000\", function () { pm.expect(Number(r.cost)).to.be.closeTo(r.total_sold * 2000000, 0.001); });",
									"pm.test(\"profit = revenue - cost\", function () { pm.expect(Number(r.profit)).to.be.closeTo(r.revenue - r.cost, 0.001); });"
								]
							}
