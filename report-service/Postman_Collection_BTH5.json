		{
			"name": "2. Báo cáo theo đơn hàng (/reports/orders)",
			"item": [
				{
					"name": "2.1 POST /reports/orders - Tạo báo cáo đơn hàng",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{report_url}}/reports/orders",
							"host": [
								"{{report_url}}"
							],
							"path": [
								"reports",
								"orders"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"order_id\": {{order_id}},\n    \"cost_prices\": [\n        {\n            \"product_id\": 1,\n            \"unit_cost\": 25000000\n        },\n        {\n            \"product_id\": 3,\n            \"unit_cost\": 2000000\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"HTTP status = 201\", function () { pm.response.to.have.status(201); });",
									"pm.test(\"success = true\", function () { pm.expect(pm.response.json().success).to.eql(true); });",
									"var r = pm.response.json().data;",
									"pm.collectionVariables.set(\"order_report_id\", r.id);",
									"pm.collectionVariables.set(\"line_report_id\", r.product_reports[0].id);",
									"pm.test(\"order_id đúng đơn vừa tạo\", function () { pm.expect(r.order_id).to.eql(Number(pm.collectionVariables.get(\"order_id\"))); });",
									"pm.test(\"total_revenue = 28500000 + 2 x 2490000 = 33480000\", function () { pm.expect(Number(r.total_revenue)).to.be.closeTo(33480000, 0.001); });",
									"pm.test(\"total_cost = 25000000 + 2 x 2000000 = 29000000\", function () { pm.expect(Number(r.total_cost)).to.be.closeTo(29000000, 0.001); });",
									"pm.test(\"total_profit = 33480000 - 29000000 = 4480000\", function () { pm.expect(Number(r.total_profit)).to.be.closeTo(4480000, 0.001); });",
									"pm.test(\"Có 2 báo cáo sản phẩm, mỗi dòng profit = revenue - cost\", function () {",
									"    pm.expect(r.product_reports.length).to.eql(2);",
									"    r.product_reports.forEach(function (p) {",
									"        pm.expect(p.order_report_id).to.eql(r.id);",
									"        pm.expect(Number(p.profit)).to.be.closeTo(p.revenue - p.cost, 0.001);",
									"        pm.expect(p.stock_quantity).to.be.a(\"number\");",
									"    });",
									"});"
								]
							}
						}
					]
				},
